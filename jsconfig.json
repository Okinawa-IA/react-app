{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@assets/*": ["src/assets/*"],
      "@core/*": ["src/core/*"],
      "@feature/*": ["src/feature/*"],
      "@routes/*": ["src/routes/*"],
      "@styles/*": ["src/styles/*"],
      "@ui/*": ["src/ui/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2020"
  }
}